{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- .",
  "rewrites": [
    {
      "source": "/key",
      "destination": "/key.html"
    },
    {
      "source": "/install",
      "destination": "/install.html"
    },
    {
      "source": "/connecq.php",
      "destination": "/api/connecq"
    },
    {
      "source": "/keyStatus.php",
      "destination": "/api/keyStatus"
    },
    {
      "source": "/beat.php",
      "destination": "/api/beat"
    },
    {
      "source": "/gtartm.php",
      "destination": "/api/gtartm"
    },
    {
      "source": "/rtm/gtartm.php",
      "destination": "/api/gtartm"
    },
    {
      "source": "/chat/chat.php",
      "destination": "/api/chat"
    },
    {
      "source": "/res/getprop.php",
      "destination": "/api/getprop"
    },
    {
      "source": "/res/downloadsprx.php",
      "destination": "/api/downloadsprx"
    },
    {
      "source": "/res/downloadasset2.php",
      "destination": "/api/downloadasset2"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "paradisesprx.vercel.app" }],
      "missing": [{ "type": "header", "key": "x-paradise-proxy" }],
      "destination": "https://paradisesprx.download/:path*",
      "permanent": true
    },
    {
      "source": "/files/Paradise.rpf",
      "destination": "https://paradisesprx.download/files/Paradise.rpf",
      "permanent": false
    },
    {
      "source": "/files/BLJM.rpf",
      "destination": "https://paradisesprx.download/files/BLJM.rpf",
      "permanent": false
    },
    {
      "source": "/files/eboot/:variant(dex|hen-a|hen-b|hen-c)/EBOOT.BIN",
      "destination": "https://paradisesprx.download/files/eboot/:variant/EBOOT.BIN",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=300"
        }
      ]
    },
    {
      "source": "/files/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, no-transform"
        }
      ]
    },
    {
      "source": "/check.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/getprop.js": {
      "includeFiles": "data/objects.txt"
    },
    "api/downloadasset2.js": {
      "includeFiles": "public/files/*.dds"
    },
    "api/downloadsprx.js": {
      "includeFiles": "public/files/ParadiseGTA*.sprx"
    }
  }
}
